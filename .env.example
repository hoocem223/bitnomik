# Copy this file to .env for local testing, then fill in real values.
# NEVER commit the actual .env file — it's already listed in .gitignore.
# On Railway, don't use this file at all: set these in the Variables tab instead.

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_here

# Optional overrides — uncomment and edit as needed
# BITNOMIK_PAIRS=BTC/USDT,ETH/USDT,LTC/USDT,SOL/USDT,XRP/USDT
# BITNOMIK_SIGNAL_COOLDOWN=1800
# BITNOMIK_CHANNEL_GAP=480
# BITNOMIK_SETUP_WINDOW=75
# BITNOMIK_MIN_SCORE=85
# BITNOMIK_REFERRAL_LINK=https://www.binance.com/register?ref=BITNOMIK
# BITNOMIK_HTTP_TIMEOUT_MS=30000
# BITNOMIK_FUNDING_SYMBOL_SUFFIX=:USDT
# BITNOMIK_TA_PERIOD_1=20
# BITNOMIK_TA_PERIOD_2=50
# BITNOMIK_TA_INTERVAL_SECONDS=3600
# BITNOMIK_TA_CANDLE_LIMIT=200
# BITNOMIK_TA_PIVOT_SPAN=2
# BITNOMIK_TA_CLUSTER_TOLERANCE_PCT=0.25
